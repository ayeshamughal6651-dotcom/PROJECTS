        userField.setFont(new Font("SansSerif", Font.PLAIN, 18));
        gbc.gridy = 1; gbc.gridwidth = 1; gbc.gridx = 0; panel.add(userLabel, gbc);
        gbc.gridx = 1; panel.add(userField, gbc);

        // Password
        JLabel passLabel = new JLabel("Password:");
        passLabel.setFont(new Font("SansSerif", Font.BOLD, 16));
        JPasswordField passField = new JPasswordField(20);
        passField.setFont(new Font("SansSerif", Font.PLAIN, 18));
        gbc.gridx = 0; gbc.gridy = 2; panel.add(passLabel, gbc);
        gbc.gridx = 1; panel.add(passField, gbc);

        // Buttons
        JButton loginBtn = new JButton("Login");
        JButton registerBtn = new JButton("Register");
        styleButton(loginBtn);
        styleButton(registerBtn);
        loginBtn.setPreferredSize(new Dimension(120, 45));
        registerBtn.setPreferredSize(new Dimension(120, 45));
        loginBtn.setFont(new Font("SansSerif", Font.BOLD, 18));
        registerBtn.setFont(new Font("SansSerif", Font.BOLD, 18));

        JPanel btnPanel = new JPanel();
        btnPanel.setBackground(new Color(245,245,245));
        btnPanel.add(loginBtn);
        btnPanel.add(registerBtn);
        gbc.gridx = 0; gbc.gridy = 3; gbc.gridwidth = 2;
        panel.add(btnPanel, gbc);

        // Background gradient
        JPanel backgroundPanel = new JPanel() {
            @Override
            protected void paintComponent(Graphics g) {
                super.paintComponent(g);
                Graphics2D g2d = (Graphics2D) g;
                g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                GradientPaint gp = new GradientPaint(0, 0, new Color(220, 245, 245), 0, getHeight(), themeColor);
                g2d.setPaint(gp);
                g2d.fillRect(0, 0, getWidth(), getHeight());
            }
        };
        backgroundPanel.setLayout(new GridBagLayout());
        backgroundPanel.add(panel);

        setContentPane(backgroundPanel);
        revalidate();
        repaint();

        loginBtn.addActionListener(e -> {
            String username = userField.getText().trim();
            String password = new String(passField.getPassword());

            if(username.equals(ADMIN_USER) && password.equals(ADMIN_PASS)){
                initAdminUI();
                return;
            }

            boolean found = false;
            for (User u : users) {
                if (u.username.equals(username) && u.password.equals(password)) {
                    found = true;
                    break;
                }
            }
            if (found) initUI();
            else JOptionPane.showMessageDialog(this, "Invalid credentials");
        });

        registerBtn.addActionListener(e -> {
            String username = userField.getText().trim();
            String password = new String(passField.getPassword());
            if (username.isEmpty() || password.isEmpty()) { JOptionPane.showMessageDialog(this,"Fill all fields"); return; }
            for (User u : users) { if(u.username.equals(username)) { JOptionPane.showMessageDialog(this,"User exists"); return; } }
            users.add(new User(username, password));
            JOptionPane.showMessageDialog(this,"Registration successful! You can login now.");
