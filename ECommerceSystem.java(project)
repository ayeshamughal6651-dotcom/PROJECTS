    private void refreshAdminTable(DefaultTableModel model){
        model.setRowCount(0);
        for(Product p: products){
            model.addRow(new Object[]{p.id, p.name, p.price, p.stock});
        }
    }

    private void adminAddProduct(DefaultTableModel model){
        JTextField idF = new JTextField();
        JTextField nameF = new JTextField();
        JTextField priceF = new JTextField();
        JTextField stockF = new JTextField();
        Object[] msg = {"ID:", idF, "Name:", nameF, "Price:", priceF, "Stock:", stockF};
        int res = JOptionPane.showConfirmDialog(this, msg, "Add Product", JOptionPane.OK_CANCEL_OPTION);
        if(res==JOptionPane.OK_OPTION){
            try{
                int id = Integer.parseInt(idF.getText().trim());
                String name = nameF.getText().trim();
                double price = Double.parseDouble(priceF.getText().trim());
                int stock = Integer.parseInt(stockF.getText().trim());
                for (Product p : products) if (p.id == id) { JOptionPane.showMessageDialog(this,"ID already exists"); return; }
                Product p = new Product(id, name, price, stock);
                products.add(p);
                refreshAdminTable(model);
            }catch(HeadlessException | NumberFormatException ex){ JOptionPane.showMessageDialog(this,"Invalid input"); }
        }
    }

    private void adminUpdateProduct(DefaultTableModel model, JTable table){
        int row = table.getSelectedRow();
        if(row==-1) { JOptionPane.showMessageDialog(this,"Select product"); return; }
        Product p = products.get(row);
        JTextField nameF = new JTextField(p.name);
        JTextField priceF = new JTextField(""+p.price);
        JTextField stockF = new JTextField(""+p.stock);
        Object[] msg = {"Name:", nameF, "Price:", priceF, "Stock:", stockF};
        int res = JOptionPane.showConfirmDialog(this, msg, "Update Product", JOptionPane.OK_CANCEL_OPTION);
        if(res==JOptionPane.OK_OPTION){
            try{
                p.name = nameF.getText().trim();
                p.price = Double.parseDouble(priceF.getText().trim());
                p.stock = Integer.parseInt(stockF.getText().trim());
                refreshAdminTable(model);
            }catch(Exception ex){ JOptionPane.showMessageDialog(this,"Invalid input"); }
        }
    }

    private void adminDeleteProduct(DefaultTableModel model, JTable table){
        int row = table.getSelectedRow();
        if(row==-1) { JOptionPane.showMessageDialog(this,"Select product"); return; }
        int confirm = JOptionPane.showConfirmDialog(this, "Delete selected product?", "Confirm", JOptionPane.YES_NO_OPTION);
        if(confirm==JOptionPane.YES_OPTION){
            products.remove(row);
            refreshAdminTable(model);
        }
    }

    private void showOrdersDialogWithSales(JLabel totalSalesLabel){
        if(orders.isEmpty()){
            JOptionPane.showMessageDialog(this, "No orders yet.");
            totalSalesLabel.setText("Total Sales: 0.00");
            return;
        }
        JTextArea ta = new JTextArea();
        ta.setEditable(false);
        double totalSales = 0;
        DecimalFormat df = new DecimalFormat("#0.00");
        for(String s: orders){
            ta.append(s + "\n\n");
            String[] lines = s.split("\n");
            for(String line: lines){
                if(line.startsWith("TOTAL:")){
                    totalSales += Double.parseDouble(line.replace("TOTAL:","").trim());
                }
            }
        }
        totalSalesLabel.setText("Total Sales: " + df.format(totalSales));
        ta.setFont(new Font("Monospaced", Font.PLAIN, 12));
        JOptionPane.showMessageDialog(this, new JScrollPane(ta), "Orders", JOptionPane.INFORMATION_MESSAGE);
    }

    private JPanel wrapGradient(JPanel panel){
        JPanel wrapper = new JPanel(){
            @Override
            protected void paintComponent(Graphics g){
                super.paintComponent(g);
                Graphics2D g2d=(Graphics2D)g;
                g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING,RenderingHints.VALUE_ANTIALIAS_ON);
                GradientPaint gp=new GradientPaint(0,0,new Color(220,245,245),0,getHeight(),themeColor);
                g2d.setPaint(gp);
                g2d.fillRect(0,0,getWidth(),getHeight());
            }
        };
        wrapper.setLayout(new BorderLayout());
        wrapper.add(panel,BorderLayout.CENTER);
        return wrapper;
    }

    // ---------------- Products Panel ----------------
    private JPanel buildProductsPanel(){
        JPanel panel = new JPanel(new BorderLayout());
        JLabel title = new JLabel("Products",SwingConstants.CENTER);
        title.setFont(new Font("Arial",Font.BOLD,22));
        title.setForeground(themeColor);
        panel.add(title,BorderLayout.NORTH);

        JPanel grid = new JPanel(new GridLayout(0,3,10,10));
        grid.setOpaque(false);
        grid.setBorder(BorderFactory.createEmptyBorder(10,10,10,10));

        for(Product p:products){
            JPanel card = new JPanel(new GridBagLayout());
            card.setBorder(BorderFactory.createLineBorder(Color.GRAY,2));
            card.setBackground(new Color(255,255,255,220));
            GridBagConstraints gbc = new GridBagConstraints();
            gbc.insets=new Insets(5,5,5,5); gbc.gridx=0; gbc.gridy=0; gbc.gridwidth=2;

            JLabel nameLabel = new JLabel(p.name);
            nameLabel.setFont(new Font("Arial",Font.BOLD,16));
            card.add(nameLabel,gbc);

            gbc.gridy++;
            card.add(new JLabel("Price: "+p.price),gbc);
            gbc.gridy++;
            JLabel stockLabel = new JLabel("Stock: "+p.stock);
            card.add(stockLabel,gbc);

            gbc.gridy++; gbc.gridwidth=1;
            card.add(new JLabel("Qty:"),gbc);
            JTextField qtyField = new JTextField("1",3);
            qtyField.setHorizontalAlignment(JTextField.CENTER);
            gbc.gridx=1; card.add(qtyField,gbc);

            gbc.gridy++; gbc.gridx=0; gbc.gridwidth=2;
            JPanel btnPanel = new JPanel(new FlowLayout());
            btnPanel.setOpaque(false);
            JButton minus = new JButton("-"), plus = new JButton("+"), addBtn = new JButton("Add to Cart");
            styleButton(addBtn);
            btnPanel.add(minus); btnPanel.add(plus); btnPanel.add(addBtn);
            card.add(btnPanel,gbc);

            minus.addActionListener(e->{
                try{
                    int q=Integer.parseInt(qtyField.getText().trim());
                    if(q>1) qtyField.setText(""+(q-1));
                }catch(Exception ex){ qtyField.setText("1"); }
            });
            plus.addActionListener(e->{
                try{
                    int q=Integer.parseInt(qtyField.getText().trim());
                    if(q+1<=p.stock) qtyField.setText(""+(q+1));
                }catch(Exception ex){ qtyField.setText("1"); }
            });
            addBtn.addActionListener(e->{
                try{
                    int qty=Integer.parseInt(qtyField.getText().trim());
                    if(qty>p.stock) { JOptionPane.showMessageDialog(this,"Exceeds stock"); return; }
                    boolean found=false;
                    for(CartItem ci:cart){ if(ci.product==p){ ci.quantity+=qty; found=true; break; } }
                    if(!found) cart.add(new CartItem(p,qty));
                    refreshCart();
                }catch(Exception ex){ JOptionPane.showMessageDialog(this,"Invalid quantity"); }
            });

            grid.add(card);
        }

        JScrollPane sp = new JScrollPane(grid);
        panel.add(sp,BorderLayout.CENTER);
        return panel;
    }

    // ---------------- Cart Panel ----------------
    private JPanel buildCartPanel(){
        JPanel panel = new JPanel(new BorderLayout());
        JLabel title = new JLabel("Cart",SwingConstants.CENTER);
        title.setFont(new Font("Arial",Font.BOLD,22));
        title.setForeground(themeColor);
        panel.add(title,BorderLayout.NORTH);

        cartTable.setFillsViewportHeight(true);
        panel.add(new JScrollPane(cartTable),BorderLayout.CENTER);

        JPanel btnPanel = new JPanel();
        JButton removeBtn = new JButton("Remove");
        JButton clearBtn = new JButton("Clear Cart");
        styleButton(removeBtn); styleButton(clearBtn);
        btnPanel.add(removeBtn); btnPanel.add(clearBtn);

        btnPanel.add(totalLabel);

        removeBtn.addActionListener(e->{
            int row = cartTable.getSelectedRow();
            if(row==-1){ JOptionPane.showMessageDialog(this,"Select item"); return; }
            cart.remove(row); refreshCart();
        });
        clearBtn.addActionListener(e->{ cart.clear(); refreshCart(); });

        panel.add(btnPanel,BorderLayout.SOUTH);
        return panel;
    }

    // ---------------- Checkout Panel ----------------
    private JPanel buildCheckoutPanel(){
        JPanel panel = new JPanel(new GridBagLayout());
        panel.setOpaque(false);
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(10,10,10,10);
        gbc.fill = GridBagConstraints.HORIZONTAL;
        gbc.gridx=0; gbc.gridy=0;

        JLabel title = new JLabel("Checkout",SwingConstants.CENTER);
        title.setFont(new Font("Arial",Font.BOLD,22));
        title.setForeground(themeColor);
        gbc.gridwidth=2; panel.add(title,gbc);

        gbc.gridwidth=1; gbc.gridy++;
        JLabel nameLbl = new JLabel("Name:"); panel.add(nameLbl,gbc);
        gbc.gridx=1; JTextField nameF = new JTextField(20); panel.add(nameF,gbc);

        gbc.gridx=0; gbc.gridy++;
        JLabel emailLbl = new JLabel("Email:"); panel.add(emailLbl,gbc);
        gbc.gridx=1; JTextField emailF = new JTextField(20); panel.add(emailF,gbc);

        gbc.gridx=0; gbc.gridy++;
        JLabel contactLbl = new JLabel("Contact No:"); panel.add(contactLbl,gbc);
        gbc.gridx=1; JTextField contactF = new JTextField(20); panel.add(contactF,gbc);

        gbc.gridx=0; gbc.gridy++;
        JLabel addressLbl = new JLabel("Address:"); panel.add(addressLbl,gbc);
        gbc.gridx=1; JTextField addressF = new JTextField(20); panel.add(addressF,gbc);

        gbc.gridx=0; gbc.gridy++; gbc.gridwidth=2;
        JButton placeOrderBtn = new JButton("Place Order");
        styleButton(placeOrderBtn);
        panel.add(placeOrderBtn,gbc);

        // ----- Updated Invoice Code -----
        placeOrderBtn.addActionListener(e -> {
            if(cart.isEmpty()){ 
                JOptionPane.showMessageDialog(this,"Cart empty"); 
                return; 
            }

            String name = nameF.getText().trim();
            String email = emailF.getText().trim();
            String contact = contactF.getText().trim();
            String address = addressF.getText().trim();

            if(name.isEmpty() || email.isEmpty() || contact.isEmpty() || address.isEmpty()){
                JOptionPane.showMessageDialog(this,"Fill all details"); 
                return;
            }

            String lowerEmail = email.toLowerCase();
            if(!(lowerEmail.contains("@") && lowerEmail.contains("gmail") && lowerEmail.contains(".") && lowerEmail.contains("com"))){
                JOptionPane.showMessageDialog(this,"Enter a valid Gmail address (must contain '@', 'gmail', '.' and 'com')");
                return;
            }

            // --- Build Invoice Table ---
            String[] columns = {"Product", "Qty", "Price", "Total"};
            Object[][] data = new Object[cart.size()][4];
            double totalAmount = 0;
            DecimalFormat df = new DecimalFormat("#0.00");

            for(int i=0; i<cart.size(); i++){
                CartItem ci = cart.get(i);
                data[i][0] = ci.product.name;
                data[i][1] = ci.quantity;
                data[i][2] = df.format(ci.product.price);
                data[i][3] = df.format(ci.getTotal());
                totalAmount += ci.getTotal();
                ci.product.stock -= ci.quantity;
            }

            JTable table = new JTable(data, columns){
                public boolean isCellEditable(int row, int column){ return false; }
            };
            table.getTableHeader().setFont(new Font("Arial", Font.BOLD, 14));
            table.setFont(new Font("Arial", Font.PLAIN, 12));
            table.setFillsViewportHeight(true);

            JLabel dateTimeLabel = new JLabel("Date & Time: " +
                    LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm")));
            dateTimeLabel.setFont(new Font("Arial", Font.BOLD, 12));
            dateTimeLabel.setForeground(new Color(0,102,204));

            JLabel totalLabelInvoice = new JLabel("TOTAL AMOUNT: " + df.format(totalAmount));
            totalLabelInvoice.setFont(new Font("Arial", Font.BOLD, 16));
            totalLabelInvoice.setForeground(Color.RED);

            JPanel invoicePanel = new JPanel(new BorderLayout(5,5));
            invoicePanel.add(dateTimeLabel, BorderLayout.NORTH);
            invoicePanel.add(new JScrollPane(table), BorderLayout.CENTER);
            invoicePanel.add(totalLabelInvoice, BorderLayout.SOUTH);

            // --- Show Invoice ---
            JOptionPane.showMessageDialog(this, invoicePanel, "AZADEN INVOICE", JOptionPane.INFORMATION_MESSAGE);

            // --- Save Order ---
            StringBuilder invoiceText = new StringBuilder();
            invoiceText.append("Customer: ").append(name).append("\nEmail: ").append(email)
                    .append("\nContact: ").append(contact).append("\nAddress: ").append(address)
                    .append("\nTOTAL: ").append(df.format(totalAmount));
            orders.add(invoiceText.toString());

            cart.clear(); 
            refreshCart();
        });

        return panel;
    }

    private void refreshCart(){
        cartModel.setRowCount(0);
        double total=0;
        for(CartItem ci:cart){
            double lineTotal=ci.getTotal();
            cartModel.addRow(new Object[]{ci.product.name, ci.product.price, ci.quantity, lineTotal});
            total+=lineTotal;
        }
        totalLabel.setText("Total: "+new DecimalFormat("#0.00").format(total));
    }

    private void styleButton(JButton btn){
        btn.setFocusPainted(false);
        btn.setBackground(themeColor);
        btn.setForeground(Color.WHITE);
        btn.setFont(new Font("Arial",Font.BOLD,14));
    }

